# Supabase Configuration
# Get these from: Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://<your-project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<your-anon-public-key>

# Backend Supabase (service role — bypasses RLS for RAG operations)
SUPABASE_URL=https://<your-project-ref>.supabase.co
# Get from: Supabase Dashboard → Project Settings → API → service_role (secret) — NEVER expose this client-side
SUPABASE_SERVICE_KEY=<your-service-role-key>

# Groq API Configuration
# Get your API key from: https://console.groq.com/keys
GROQ_API_KEY=<your-groq-api-key>

# AI Provider Configuration
# Use `groq` for hosted inference or `ollama` for a local model running on your machine.
AI_PROVIDER=groq

# Ollama Configuration (used when AI_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct

# Prompt budgeting for relevant answers without oversized requests
RAG_MATCH_COUNT=6
RAG_NEIGHBOR_WINDOW=1
RAG_MAX_CONTEXT_CHARS=4500
RAG_MATCH_THRESHOLD=0.05
RAG_FALLBACK_MIN_SIMILARITY=0.02
RAG_FALLBACK_MATCH_COUNT=6
CHAT_HISTORY_LIMIT=3
AI_MAX_OUTPUT_TOKENS=512

# Backend Server Port
PORT=3001

# Backend URL used by the frontend (change this if deploying)
VITE_BACKEND_URL=http://localhost:3001

# Comma-separated list of admin emails who can access platform-only pages
# (analytics, knowledge base, settings, chatbot manage).
VITE_ADMIN_EMAILS=owner@yourcompany.com

# Optional backend alias for admin emails (if omitted, backend falls back to VITE_ADMIN_EMAILS)
ADMIN_EMAILS=owner@yourcompany.com

# Comma-separated list of superadmin emails.
# Superadmin can access all admin pages plus superadmin-only user-role controls.
VITE_SUPERADMIN_EMAILS=founder@yourcompany.com

# Optional backend alias for superadmin emails.
SUPERADMIN_EMAILS=founder@yourcompany.com

# Default chatbot cap when user has no active paid pack/subscription
DEFAULT_NO_PLAN_BOT_LIMIT=1

# Default monthly message cap when user has no active paid pack/subscription
DEFAULT_NO_PLAN_MESSAGE_LIMIT=1000
